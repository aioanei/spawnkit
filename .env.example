# Copy this file to .env (ignored by git) and fill in the values. Never commit .env or paste keys into chats or logs.
# tools/run-server-local.ps1 loads it into the local server's environment only.

# Text AI for the assistant (ADR-0011).
ANTHROPIC_API_KEY=
# Image model for Character Forge (ADR-0013).
OPENAI_API_KEY=

# Local development: account codes are printed to the server console instead of emailed.
SPAWNKIT_LOCAL=1

# Spending limits. Defaults: $20 a month for the whole server and $1 a day per account.
# Uncomment and raise them while testing in alpha.
# SPAWNKIT_AI_MONTHLY_DOLLARS=100
# SPAWNKIT_AI_ACCOUNT_DAILY_DOLLARS=20
